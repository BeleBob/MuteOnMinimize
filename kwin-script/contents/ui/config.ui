     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_MuteInBackground">
     <property name="text">
      <string>Also mute when another window is in front of the application on its screen (for example, after Alt+Tab)</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelWindowMenu">
     <property name="text">
      <string>You can also select the application of any window from its menu (Alt+F3 → Mute when minimized) or with the Meta+Ctrl+M shortcut.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelWindowClass">
     <property name="text">
      <string>To find a window's class, open Window Rules in System Settings, add a rule and click Detect Window Properties.</string>
